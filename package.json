{
  "name": "gatosports-running-app",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.19.4" },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server run start",
    "db:setup": "npm --prefix server run db:setup",
    "db:seed": "npm --prefix server run db:seed"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "expo": "~57.0.25",
    "expo-crypto": "~57.0.3",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.20",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~5.9.2"
  }
}
