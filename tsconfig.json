{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "components/**/*.ts", "components/**/*.tsx", "constants/**/*.ts", "data/**/*.ts", "hooks/**/*.ts", "hooks/**/*.tsx", "lib/**/*.ts", "storage/**/*.ts", "types/**/*.ts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["server/**", "node_modules/**"]
}
