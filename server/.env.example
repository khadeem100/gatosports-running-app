NODE_ENV=development
PORT=4100
TRUST_PROXY=true
PG_POOL_MAX=8
DATABASE_URL=postgresql://APP_ROLE:APP_PASSWORD@YOUR_NEON_ENDPOINT-pooler.REGION.aws.neon.tech/gatosports_running?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://APP_ROLE:APP_PASSWORD@YOUR_NEON_ENDPOINT.REGION.aws.neon.tech/gatosports_running?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_API_URL=https://running-api.your-domain.example
CORS_ORIGINS=
PRESTASHOP_API_BASE_URL=
PRESTASHOP_WEB_SERVICE_KEY=
PRESTASHOP_LANGUAGE_ID=1
